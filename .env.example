GROQ_API_KEY=your_groq_api_key_here

# PostgreSQL (used by the .NET API)
POSTGRES_USER=pawnalysis
POSTGRES_PASSWORD=pawnalysis
POSTGRES_DB=pawnalysis

# JWT (used by the .NET API). Generate a strong random secret, e.g.:
#   openssl rand -base64 48
JWT_KEY=your_jwt_signing_key_here
JWT_ISSUER=pawnalysis-api
JWT_AUDIENCE=pawnalysis-client